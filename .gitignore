# Dependencias
node_modules/

# Builds
dist/
.next/
out/
build/
.turbo/

# Tests / cobertura
coverage/
playwright-report/
test-results/

# Entorno (nunca subir secretos — §4 de la constitución)
.env
.env.*
!.env.example

# Logs y temporales
*.log
*.tsbuildinfo

# Sistema
.DS_Store

# Artefactos de tooling de agentes (no son parte del monorepo)
/.agents/
/skills-lock.json
/videos/
.vercel

# .claude/: lo compartido se versiona (permisos del proyecto y skills, para que
# cualquier agente en cualquier máquina los herede); el estado local, no.
.claude/*
!.claude/settings.json
!.claude/skills/

# Documentos que nos entrega un cliente (Excel de operación, actas de reunión,
# formatos contables). Son datos suyos —saldos, nombres de sus clientes,
# transcripciones— y no tienen por qué vivir en el repositorio. Se consultan
# desde local; si alguna vez hay que versionar algo, se decide a propósito.
apps/*/Documentos_base/
