{
  "name": "evetev",
  "version": "0.0.0",
  "private": true,
  "description": "Evetev SAS — EvePay (plataforma de pagos) y sus verticales. Monorepo.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=9"
  },
  "scripts": {
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "landings:sync": "node scripts/landings-sync.mjs",
    "landings:check": "node scripts/landings-sync.mjs --check",
    "marca:imagen": "node scripts/marca-imagen.mjs",
    "marca:sync": "node scripts/marca-sync.mjs",
    "marca:check": "node scripts/marca-sync.mjs --check",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@evetev/config": "workspace:*",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  }
}
