{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": ".",
  "functions": {
    "api/contacto.js": {
      "maxDuration": 10
    }
  },
  "trailingSlash": false,
  "redirects": [
    { "source": "/eveconecta", "destination": "/conecta", "permanent": true },
    { "source": "/eveintelligence", "destination": "/intelligence", "permanent": true },
    { "source": "/eve-intelligence", "destination": "/intelligence", "permanent": true }
  ],
  "ignoreCommand": "git rev-parse HEAD^ >/dev/null 2>&1 || exit 1; git diff --quiet HEAD^ HEAD -- . ../../packages/brand/landing"
}
