# EveLedger — variables de entorno. Copia a `.env` y completa (§4: nunca subir secretos).

# Postgres. En local: `createdb eveledger` y conexión sin password.
# En producción: cadena del pooler de Supabase (:6543) del proyecto de EveLedger.
DATABASE_URL="postgresql://usuario@localhost:5432/eveledger"

# Secreto con el que se firma la cookie de sesión (HMAC-SHA256). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Usuario administrador que crea `pnpm db:sembrar`. Cámbialos antes de sembrar
# producción: son las credenciales con las que se entra a la aplicación.
ADMIN_EMAIL="admin@eveledger.local"
ADMIN_PASSWORD=""
