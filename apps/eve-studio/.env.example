# Copiar a .env para desarrollo local. NUNCA subir .env al repo (§4).
# En producción estas variables van en las Environment Variables del
# proyecto de Vercel de apps/eve-studio, no en un archivo.

# Motor del agente (Moonshot / Kimi)
MOONSHOT_API_KEY=""

# Lectura de los activos de marca desde GitHub. Ya no hay repo de marca: viven
# en packages/brand de este monorepo, así que basta con REPO_CODIGO.
# Solo necesita permiso de lectura de contenidos.
GITHUB_TOKEN=""

# Lectura del monorepo de código (EveTevSas/evetevbrain), para que el agente
# parta del archivo que ya existe en vez de reescribirlo desde cero.
# NO reutilices aquí el GITHUB_TOKEN de arriba: un token de alcance fino está
# limitado a UNA organización, y poner el de Evetev-Dev hace que GitHub responda
# 403 en un repositorio que, sin credencial, se sirve sin problema.
# Puede quedar vacía —el monorepo es público— pero sin autenticar son 60
# peticiones por hora y por IP, compartidas con el resto de Vercel. Con token
# propio, 5000. El correcto: alcance fino, dueño EveTevSas, repo evetevbrain,
# Contents Read-only.
GITHUB_TOKEN_CODIGO=""

# Opcional: solo para apuntar a otro repositorio. REPO_MARCA ya no existe — la
# marca vive en packages/brand de este mismo monorepo desde que se borró
# Evetev-Dev/brand, así que un solo repo y una sola credencial.
# REPO_CODIGO="EveTevSas/evetevbrain"

# Token compartido que protege el endpoint. Sin él la API responde 503 y no
# atiende: el agente gasta créditos de Moonshot, así que no puede quedar
# abierto al público. Generar uno con: openssl rand -hex 32
AGENTE_API_TOKEN=""
