# Copiar a .env para desarrollo local. NUNCA subir .env al repo (§4).
# En producción estas variables van en las Environment Variables del
# proyecto de Vercel de apps/eve-studio, no en un archivo.

# Motor del agente (Moonshot / Kimi)
MOONSHOT_API_KEY=""

# Lectura de los activos de marca desde GitHub (repo Evetev-Dev/brand).
# Solo necesita permiso de lectura de contenidos.
GITHUB_TOKEN=""

# Lectura del monorepo de código (EveTevSas/evetevbrain), para que el agente
# parta del archivo que ya existe en vez de reescribirlo desde cero.
# Hoy se puede dejar VACÍA: el monorepo es público y un token de alcance fino
# lee cualquier repo público. Hace falta el día que pase a privado, porque los
# tokens de alcance fino pertenecen a una sola organización y estos dos repos
# están en organizaciones distintas.
GITHUB_TOKEN_CODIGO=""

# Opcionales: solo para apuntar a otros repositorios.
# REPO_MARCA="Evetev-Dev/brand"
# REPO_CODIGO="EveTevSas/evetevbrain"

# Token compartido que protege el endpoint. Sin él la API responde 503 y no
# atiende: el agente gasta créditos de Moonshot, así que no puede quedar
# abierto al público. Generar uno con: openssl rand -hex 32
AGENTE_API_TOKEN=""
