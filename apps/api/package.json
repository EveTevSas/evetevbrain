{
  "name": "@evetev/api",
  "version": "0.0.0",
  "private": true,
  "description": "EvePay — la plataforma de pagos (núcleo). No conoce el dominio de ninguna vertical.",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@evetev/shared": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "drizzle-orm": "^0.44.2",
    "postgres": "^3.4.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@evetev/config": "workspace:*",
    "@nestjs/cli": "^11.0.0",
    "@types/node": "^26.1.2",
    "drizzle-kit": "^0.31.1",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
}
