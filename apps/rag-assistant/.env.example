# Copiar a .env para desarrollo local. NUNCA subir .env al repo (§4).
# En produccion estas variables van en las Environment Variables del proyecto
# de Vercel de apps/rag-assistant, no en un archivo.

# Motor generador (Moonshot / Kimi). La cuenta ya existe: es la misma que usa
# apps/eve-studio.
MOONSHOT_API_KEY=""

# Modelo. Se eligio midiendo, no por catalogo: ver la tabla del README.
FLUXI_MODELO="kimi-k2.6"

# Vectorizador (Alibaba Cloud Model Studio) — TODAVIA NO SE USA.
# La mitad densa de la recuperacion entra cuando exista la base definitiva:
# los vectores hay que recalcularlos cuando el corpus cambie, y el corpus se
# reescribe. Pagarlos sobre un corpus que se va a tirar no tiene sentido.
MODEL_STUDIO_API_KEY=""

