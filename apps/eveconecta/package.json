{
  "name": "@evetev/eveconecta",
  "version": "0.1.0",
  "private": true,
  "description": "EveConecta — primera vertical: dashboard de conjuntos residenciales. Consume EvePay por HTTP.",
  "scripts": {
    "auth:provision-user": "node scripts/provision-user.mjs",
    "build": "next build",
    "db:deploy": "supabase db push --linked",
    "db:lint": "supabase db lint --local --schema conjuntos --level error",
    "db:lint:linked": "supabase db lint --linked --schema conjuntos --level error",
    "db:migrations:status": "supabase migration list --linked",
    "db:reset": "supabase db reset",
    "db:start": "supabase start",
    "db:status": "supabase status",
    "db:stop": "supabase stop",
    "db:test": "supabase test db supabase/tests --local",
    "db:test:linked": "supabase test db supabase/tests --linked",
    "dev": "next dev --port 3002",
    "lint": "eslint app components db lib tests --max-warnings=0",
    "start": "next start --port 3002",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "1.2.2",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-dropdown-menu": "2.1.20",
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.7",
    "clsx": "2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "1.25.0",
    "next": "16.2.10",
    "postgres": "^3.4.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "recharts": "3.9.2",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "postcss": "8.5.19",
    "tailwindcss": "4.3.3",
    "vitest": "4.1.10"
  }
}
