# Supabase Auth y Data API (valores locales: `pnpm db:status`)
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:55321"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Solo para ejecutar manualmente `pnpm auth:provision-user` desde un entorno
# administrativo seguro. No se despliega en el runtime ni se expone al navegador.
SUPABASE_URL="http://127.0.0.1:55321"
SUPABASE_SECRET_KEY=""
SUPABASE_INVITE_REDIRECT_URL="http://localhost:3002/auth/callback?next=/actualizar-contrasena"

# Conexión exclusiva del servidor de EveConecta. Nunca usar en Client Components.
# En Supabase alojado, usar la URL del pooler en modo transacción.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:55322/postgres"

# EvePay se consume únicamente por HTTP; nunca mediante su schema de Postgres.
NEXT_PUBLIC_API_URL="http://localhost:3001"
