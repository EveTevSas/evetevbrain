# Copia este archivo a .env y completa los valores. NUNCA subas .env al repo (§4).

# --- Base de datos (Supabase / Postgres) ---
DATABASE_URL="postgresql://user:password@localhost:5432/evetev"

# --- Auth (Supabase) ---
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- EvePay / adquirencia (proveedor detrás de PaymentProvider) ---
# En local y CI se usa la implementación fake; sin credenciales reales.
PAYMENT_PROVIDER="fake"           # fake | akua | combopay
AKUA_API_KEY=""
AKUA_WEBHOOK_SECRET=""
# ComboPay (Recaudos beta). Token del dashboard (Perfil → Claves API).
COMBOPAY_API_TOKEN=""
# COMBOPAY_BASE_URL=""            # omitir en producción (api-gateway.combopay.co)
# Secreto propio para la URL del hook: /v1/webhooks/combopay/<secreto>.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COMBOPAY_WEBHOOK_SECRET=""
# JWT de la consola de administración (admin-console CA-3): secreto JWT del
# proyecto Supabase de EvePay para verificar el rol super_admin en la API.
SUPABASE_JWT_SECRET=""

# --- API ---
API_PORT="3001"

# --- Web conjuntos ---
NEXT_PUBLIC_EVEPAY_API_URL="http://localhost:3001"

# --- Sitio web: formularios de contacto y postulación ---
# Se configuran en las variables de entorno del proyecto Vercel de apps/website,
# no en un .env local (el sitio es estático y no tiene build).
# Sin RESEND_API_KEY el formulario no envía: muestra el correo de la empresa
# como salida, así que la página nunca queda rota.
RESEND_API_KEY=""
CONTACTO_DESTINO="contacto@evetev.com"
# El remitente va en un SUBDOMINIO verificado (send.evetev.com), no en el
# dominio raíz: evetev.com recibe en Google Workspace y el MX de rebotes del
# proveedor de envío chocaría con el de Google.
CONTACTO_REMITENTE="Web Evetev <web@send.evetev.com>"
